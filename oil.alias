<drac2>
al_name = 'oil'
footer = f'!{al_name} ? | Enter Ravenloft Blade Oil alias'

using(jh='65a30ab9-540c-4bdf-86ce-7af4760604a9')
jh.setup(
        al_name=al_name,
        footer=footer,
        )
using(bl=jh.LIB['baglib'])
dtypes = ['acid', 'cold', 'fire', 'poison', 'lightning', 'thunder', 'force', 'psychic', 'radiant', 'necrotic']

ch = character()
co = combat()
type_cvar = 'oilTypeDefault'

args = &ARGS&

if not args or args[0].lower() in ['?', 'help']:
    return jh.embed(
        title='Blade Oil Alias Manual',
        desc=(f'Applies Blade Oil with the specified element, with optional bag management.\n\n'
              f'**Usage**:\n'
              f'`!oil <element> [-type {{ammo,blade}}] [-bag <bagName>]* [-t <target>]* [nobag]`\n'
              f'* The `element` needs to be the full name of the element ("cold", "necrotic", "radiant", etc.)\n'
              f'* `-bag`: Bag names can be provided to search only those bags.\n'
              f'* `-type`: specifies whether it\'s applied to ammo or blade. If it\'s ammo, a custom counter '
              f'will be created to track the 6 ammunitions coated with this blade oil application. '
              f'Defaults to `blade`.\n'
              f'  * If applied to another combatant via `-t`, only `blade` is available.\n'
              f'  * Set the default type with `!cvar {type_cvar} ammo|blade`\n'
              f'* `nobag`: will ignore bag management\n'
              f'* `-t <target>`: (optional) applies the Blade Oil effect to the specified target(s).\n\n'
              f'`!oil cc <element>`\n'
              f'* Creates the necessary cc for the specified element, for ammo use case\n'
              f'* If the cc already exists, do nothing\n\n'
              f'**Bag management (not enforced)**\n'
              f'This alias will look for items named "Blade Oil (element)" or "element Blade Oil" in all '
              f'your bags. If you specify bag names with `-bag`, it will only search those bags.\n\n'
              f'**In Combat**\n'
              f'In combat, this alias will apply the effect "Blade Oil (element)" to the active character. '
              f'You can then use the __snippet `oil`__ when attacking to automatically apply the extra damage, '
              f'as well as the ammunition tracking.\n'
              f'If you have multiple blade oil effects, when using the snippet you can also add `oilRadiant` or '
              f'`oilFire` immediately after `oil` to choose which element you are using with that attack, for example:\n'
              f'`!a longsword -t ZO1 oil oilCold`"'),
        )

if args[0] == 'cc':
    if len(args) == 1:
        return jh.embed(
            title='Element type missing! :x:',
            desc=(f'You ran `!oil cc` without specifying the element type\n'
                  f'__**Usage**__:\n'
                  f'`!oil cc <element>`\n'
                  f'* Creates the necessary cc for the specified element, for ammo use case\n'
                  f'* If the cc already exists, do nothing\n\n'
                  f'To delete a CC, simply run:\n'
                  f'`!cc delete <ccname>`'),
            )
    el = args[1].lower().strip()
    item_name = f'Blade Oil ({el})'
    counter = ch.create_cc(item_name, 0, initial_value=6,
                             desc=f'{item_name} applied to ammo. Lasts 1 minute.')
    return jh.embed(
        title=f'Custom counter created! :white_check_mark:',
        desc=f'The custom counter "{item_name}" was created.',
        fields=[{'title':counter.name,
                 'body':counter.full_str()}],
        )

p_args = argparse(args)
k_args, l_args = jh.take_args(args, {'-type':True, '-bag':True, '-t':True, 'nobag':False})

# Canonical blade oil name, also used for CC
if not l_args:
    return jh.embed(
        title=f'Failed to apply Blade Oil! :x:',
        desc=(f'No damage element supplied.\n\n'
              f'__**Usage**__:\n'
              f'`!oil <element> [-type {{ammo,blade}}] [-bag <bagName>]* [-t <target>]* [nobag]`\n'
              f'* The `element` needs to be the full name of the element ("cold", "necrotic", "radiant", etc.)\n'
              f'* `-bag`: Bag names can be provided to search only those bags.\n'
              f'* `-type`: specifies whether it\'s applied to ammo or blade. If it\'s ammo, a custom counter '
              f'will be created to track the 6 ammunitions coated with this blade oil application. '
              f'Defaults to `blade`.\n'
              f'  * If applied to another combatant via `-t`, only `blade` is available.\n'
              f'  * Set the default type with `!cvar {type_cvar} ammo|blade`\n'
              f'* `nobag`: will ignore bag management\n'
              f'* `-t <target>`: (optional) applies the Blade Oil effect to the specified target(s).'),
        )
el = l_args[0].lower().strip()
item_name = f'Blade Oil ({el})'

# Defines the output embed `out`
out = {}
fs = []
out['fields'] = fs
warns = []

ignore_bag = bool(k_args['nobag'])
# Targets
ts = k_args['-t']
uniq, mult, none = jh.resolve_targets(ts)
if mult:
    mult_s = '\n* '.join(['']+[f'{t}: {", ".join(comb.name for comb in combs)}' for t, combs in mult])
    warns.append({'title':'Some targets have multiple matches :x:',
                  'body':f'The following targets have multiple matches:\n{mult_s}',
                  })
if none:
    none_s = '\n* '.join(['']+[t for t, _ in none])
    warns.append({'title':'Some targets have no matches :x:',
                  'body':f'The following targets have no matches:\n{none_s}',
                  })
if ts and (mult or none):
    out['title'] = 'Fail to apply blade oil to targets! :x:'
    out['desc'] = (f'Some targets specified, but no valid targets found or they have multiple matches. '
                   f'Nothing has been done.\n'
                   f'If you want to apply the blade oil effect to yourself, no need to specify targets. '
                   f'Simply run:\n'
                   f'`!{al_name} <element>`')
    fs.extend(warns)
    return jh.embed(**out)

if ts and (len(uniq) > 1 or not co.me or uniq[0][1][0].name != co.me.name):
    has_target = True
else:
    has_target = False

bag_names = k_args['-bag']
bags = bl.load_bags()
has_names = True
cur_bags = []
if bag_names:
    # Convert to canonical bag names, ignoring bags not found
    for bag_name in bag_names:
        bag = bl.get_bag(bags, bag_name)
        if bag:
            cur_bags.append(bag)
if not bag_names:
    has_names = False
    cur_bags = [bag for bag in bags] # Deep copy

def take_blade_oil(bag, el):
    for cur_item, count in bag[1].items():
        # If matches '<element> Blade Oil' or 'Blade Oil (<element>)' ignoring case
        # Should not match 'Mats for Radiant Blade Oil' or 'Blade Oil Cold mats' or others
        # Ok to accept punctuations like 'Blade Oil - <element>` or 'Blade Oil: <element>'
        words = [w for w in cur_item.split(' ') if len(w) > 2]
        if len(words) != 3:
            continue
        if cur_item.lower().startswith('blade oil'):
            cur_el = words[2].lower()
            if cur_el[0] == '(' and cur_el[-1] == ')':
                cur_el = cur_el.strip('()')
            if el and el != cur_el:
                continue
            if count >= 1:
                bag[1][cur_item] -= 1
            else:
                continue
            return cur_item, cur_el
        if cur_item.lower().endswith('blade oil'):
            cur_el = words[0].lower()
            if el and el != cur_el:
                continue
            if count >= 1:
                bag[1][cur_item] -= 1
            else:
                continue
            return cur_item, cur_el
    return None, None

found_bag = None
found_item = None
missed_bags = []
if not ignore_bag:
    for bag in cur_bags:
        blade_oil, cur_el = take_blade_oil(bag, el)
        if blade_oil:
            found_bag = bag
            found_item = blade_oil
            break
        else:
            if has_names:
                missed_bags.append(bag[0])
    if not found_item and el not in dtypes:
        return jh.embed(
            title=f'Invalid damage type! :x:',
            desc=(f'The provided damage type "{el}" is not a standard damage type, and neither can a corresponding '
                  f'blade oil item be found in your bag. If you really intended to use this custom damage type, you '
                  f'can add `nobag` to use this damage type.'),
        )

if not has_target:
    if not co:
        return jh.embed(
            title=f'Failed to apply Blade Oil! :x:',
            desc=(f'This channel is not in combat!'),
        )
    if not co.me:
        return jh.embed(
            title=f'Failed to apply Blade Oil! :x:',
            desc=(f'{jh.ch_name()} is not in combat!'),
        )
    out['title'] = f'{jh.ch_name()} applies {item_name} for themselves!'
elif len(uniq) == 1:
    out['title'] = f'{jh.ch_name()} applies {item_name} for {uniq[0][1][0].name}!'
else:
    out['title'] = f'{jh.ch_name()} applies {item_name} for multiple targets!'
out['desc'] = (f'These fine oils are made by skilled alchemists. '
               f'Some are said to be made from the spit of dragons, others from the blood of angels. '
               f'A given flask of blade oil is associated with one damage type, based on the materials used. '
               f'You can apply blade oil to a melee weapon or 6 pieces of ammunition as an action.\n\n'
               f'Every attack made with that weapon or ammunition before the oil dries deals an extra 1d4 '
               f'damage of that specific oil\'s damage type.')
if found_item:
    for bag in bags:
        if bag[0] == found_bag[0]:
            bag[1] = found_bag[1]
            break
    bl.save_bags(bags)
    fs.append({'title':'Bag Management :white_check_mark:',
               'body':f'Removed "{found_item}" x1 from **{found_bag[0]}**',
               })
elif ignore_bag:
    fs.append({'title':'Bag Management :information_source:',
               'body':f'`nobag` supplied, bag management ignored.',
               })
else:
    fs.append({'title':'Bag Management :information_source:',
               'body':(f'No items named "{el.title()} Blade Oil" or "Blade Oil ({el.lower()})" found in '
                       f'the specified bags, bag management ignored.'),
               },
             )

apply_type = (k_args['-type']+[None])[0]
type_from_cvar = True
if apply_type is not None:
    type_from_cvar = False
else:
    apply_type = ch.get_cvar(type_cvar, None)
    if apply_type is not None:
        type_from_cvar = True
if type_from_cvar:
    application_source = f'`!cvar {type_cvar}`'
else:
    application_source = f'`-type {apply_type}`'
if apply_type is None:
    fs.append({'title':'Using default application type :information_source:',
               'body':(f'Application type defaults to `blade`.\n'
                       f'To use as ammo, create the custom counter by running:\n'
                       f'`!oil cc {el}`'),
               })
elif apply_type not in ['ammo', 'blade']:
    extra_s = f' (from {application_source})' if type_from_cvar else ''
    fs.append({'title':'Invalid application type :warning:',
               'body':(f'`{apply_type}`{extra_s} is not a valid application type. '
                       f'Choose either `ammo` or `blade`. Defaulting to `blade` now.\n'
                       f'To instead use as ammo for this application, create the custom counter by running:\n'
                       f'`!oil cc {el}`'),
               })
    apply_type = 'blade'
elif apply_type == 'ammo':
    # Handle ammo cc creation
    if has_target:
        fs.append({'title':'Application type changed :information_source:',
                   'body':(f'Blade Oil applied not to self, so `ammo` application type is not supported. '
                           f'Defaulting to `blade`.'),
                   })
    else:
        cc_op_title = ''
        if ch.cc_exists(item_name):
            counter = ch.cc(item_name)
            counter.mod(6)
            cc_op_title = f'Updated counter: {counter.name} :white_check_mark:'
        else:
            counter = ch.create_cc(item_name, 0, initial_value=6,
                                     desc=f'{item_name} applied to ammo. Lasts 1 minute.')
            cc_op_title = f'Created counter: {counter.name} :white_check_mark:'
        fs.append({'title':cc_op_title,
                   'body':(f'{counter.desc}\n{counter.full_str()}\n'
                           f'__**Note**__: If you intended this to not be ammo, you can delete this CC with '
                           f'`!cc delete "{counter.name}"`\n'),
                   })
else:
    # Blade application
    fs.append({'title':'Application type: `blade` :information_source:',
               'body':(f'Application type obtained from {application_source}\n'
                       f'__**Note**__: To instead use as ammo for this application, '
                       f'create the custom counter by running:\n'
                       f'`!oil cc {el}`'),
               })

# Handles ieffect attach
if not has_target:
    if co and co.me:
        co.me.add_effect(item_name, duration=10)
        fs.append({'title':'Effect :placard:',
                   'body':f'Added effect {item_name} to {co.me.name} [1 minute]',
                   })
else:
    eff = []
    for t, [comb] in uniq:
        comb.add_effect(item_name, duration=10)
        eff.append(f'Added effect {item_name} to {comb.name} [1 minute]')
    eff_s = '\n'.join(eff)
    fs.append({'title':'Effect :placard:',
               'body':eff_s})

fs.append({'title':'Snippet: `oil` :information_source:',
           'body':(f'You can now use the `oil` snippet to apply the extra 1d4 damage.\n'
                   f'The damage type will be automatically read from the effect, as long as the effect is named '
                   f'"Blade Oil (<damage type here>)"\n\n'
                   f'If you have multiple blade oil effects, when using the snippet you can also add `oilRadiant` '
                   f'or `oilFire` immediately after `oil` to choose which element you are using with that attack, '
                   f'for example:\n'
                   f'`!a longsword -t ZO1 oil oilCold`'),
           })

return jh.embed(**out)
</drac2>
